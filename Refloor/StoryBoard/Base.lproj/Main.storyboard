                                                </constraints>
                                                <attributedString key="attributedText">
                                                    <fragment content="Floor Protection: ">
                                                        <attributes>
                                                            <color key="NSColor" red="0.1764705882352941" green="0.20392156862745098" blue="0.23921568627450979" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                            <font key="NSFont" size="18" name="Avenir-Heavy"/>
                                                            <font key="NSOriginalFont" size="18" name="Avenir-Heavy"/>
                                                            <paragraphStyle key="NSParagraphStyle" alignment="left" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO"/>
                                                        </attributes>
                                                    </fragment>
                                                    <fragment>
                                                        <string key="content">While our floors are scratch-resistant, they are not scratch-proof. Your floor will scratch if you do not take steps to protect it. To minimize scratching, Owner agrees to place felt pads or cups on the bottom of all furniture legs or casters and not to roll or push heavy items across the floor. Instead, all items must be lifted and placed in the desired location. Furniture and seating with rolling casters or wheels will damage floors, and that damage is not covered under our Lifetime Warranty.</string>
                                                        <attributes>
                                                            <color key="NSColor" red="0.1764705882352941" green="0.20392156862745098" blue="0.23921568627450979" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                            <font key="NSFont" size="18" name="Avenir-Medium"/>
                                                            <font key="NSOriginalFont" size="18" name="Avenir-Medium"/>
                                                            <paragraphStyle key="NSParagraphStyle" alignment="left" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO"/>
                                                        </attributes>
                                                    </fragment>
                                                </attributedString>
                                                <nil key="highlightedColor"/>
