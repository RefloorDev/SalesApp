                                                        </attributes>
                                                    </fragment>
                                                    <fragment>
                                                        <string key="content">In some cases, extra layers of flooring may exist under the top surface that the sales consultant could not have seen. If the installer deems</string>
                                                        <attributes>
                                                            <color key="NSColor" red="0.1764705882352941" green="0.20392156862745098" blue="0.23921568627450979" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
