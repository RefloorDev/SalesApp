                                                <attributedString key="attributedText">
                                                    <fragment content="Protecting Your Floor:">
                                                        <attributes>
                                                            <color key="NSColor" red="0.13333" green="0.12157" blue="0.12157" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                            <font key="NSFont" size="18" name="Avenir-Heavy"/>
                                                            <real key="NSKern" value="0.0"/>
                                                            <paragraphStyle key="NSParagraphStyle" alignment="left" lineBreakMode="wordWrapping" baseWritingDirection="leftToRight" paragraphSpacing="12" defaultTabInterval="36" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO">
                                                                <tabStops/>
                                                            </paragraphStyle>
                                                            <color key="NSStrokeColor" red="0.13333" green="0.12157" blue="0.12157" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                        </attributes>
                                                    </fragment>
                                                    <fragment content=" ">
                                                        <attributes>
                                                            <color key="NSColor" red="0.13333" green="0.12157" blue="0.12157" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                            <font key="NSFont" size="13.333" name="ArialNarrow-Bold"/>
                                                            <real key="NSKern" value="0.0"/>
                                                            <paragraphStyle key="NSParagraphStyle" alignment="left" lineBreakMode="wordWrapping" baseWritingDirection="leftToRight" paragraphSpacing="12" defaultTabInterval="36" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO">
                                                                <tabStops/>
                                                            </paragraphStyle>
                                                            <color key="NSStrokeColor" red="0.13333" green="0.12157" blue="0.12157" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                        </attributes>
                                                    </fragment>
                                                    <fragment>
                                                        <string key="content">While our floors are scratch-resistant, they are not scratch-proof. Your floor will scratch if you do not take steps to protect it. To minimize scratching, Owner agrees to place felt pads or cups on the bottom of all furniture legs or casters and not to roll or push heavy items across the floor. Instead, all items must be lifted and placed in the desired location. Furniture and seating with rolling casters or wheels, including wheelchairs, will damage floors, and that damage is not covered under our Lifetime Guarantee. Rubber, such as rubber-backed rugs, may discolour vinyl floors, Cleaning with certain mops or abrasives may lead to damaging the wear layer of your floors and may leave prolonged splotches. See Refloor's 5-Plank Guarantee for details on coverage of damaged floors.</string>
                                                        <attributes>
                                                            <color key="NSColor" red="0.13333" green="0.12157" blue="0.12157" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                            <font key="NSFont" size="18" name="Avenir-Medium"/>
                                                            <real key="NSKern" value="0.0"/>
                                                            <paragraphStyle key="NSParagraphStyle" alignment="left" lineBreakMode="wordWrapping" baseWritingDirection="leftToRight" paragraphSpacing="12" defaultTabInterval="36" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO">
                                                                <tabStops/>
                                                            </paragraphStyle>
                                                            <color key="NSStrokeColor" red="0.13333" green="0.12157" blue="0.12157" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                        </attributes>
                                                    </fragment>
                                                </attributedString>
                                                <nil key="highlightedColor"/>
                                            </label>
