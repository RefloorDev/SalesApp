                                                        </attributes>
                                                    </fragment>
                                                    <fragment>
                                                        <string key="content">Installation will be scheduled when crew and material availability permits. Schedule times are approximate. Due to circumstances </string>
                                                        <attributes>
                                                            <color key="NSColor" red="0.1764705882352941" green="0.20392156862745098" blue="0.23921568627450979" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
