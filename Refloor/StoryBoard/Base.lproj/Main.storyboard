                                                        </attributes>
                                                    </fragment>
                                                    <fragment>
                                                        <string key="content"> All installations must be done within 30 days of signing this Contract. Any order exceeding 30 days will require payment of 50% of the contract price to secure materials, warehouse space, and delivery cost.</string>
                                                        <attributes>
                                                            <color key="NSColor" red="0.1764705882352941" green="0.20392156862745098" blue="0.23921568627450979" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
