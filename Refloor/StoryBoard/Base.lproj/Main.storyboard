                                        <rect key="frame" x="0.0" y="0.0" width="820" height="1300"/>
                                        <subviews>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="BUYER’S RIGHT TO CANCEL" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="nPx-27-GxW">
                                                <rect key="frame" x="20" y="40" width="780" height="38"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="38" id="ieE-Ld-rWe"/>
                                                </constraints>
                                                <fontDescription key="fontDescription" name="Avenir-Black" family="Avenir" pointSize="32"/>
