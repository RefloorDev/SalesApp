                                                <rect key="frame" x="92" y="1595" width="908" height="74"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" priority="250" constant="74" id="JAM-aX-euv"/>
                                                </constraints>
                                                <attributedString key="attributedText">
                                                    <fragment content="Deposit: ">
                                                        <attributes>
                                                            <color key="NSColor" red="0.1764705882" green="0.20392156859999999" blue="0.23921568630000001" alpha="1" colorSpace="calibratedRGB"/>
                                                            <font key="NSFont" size="18" name="Avenir-Heavy"/>
                                                            <paragraphStyle key="NSParagraphStyle" alignment="left" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO"/>
                                                        </attributes>
                                                    </fragment>
                                                    <fragment>
                                                        <string key="content">Concurrent with the execution of this Contract, a deposit of 50% is requested (if financing, a minimum of $200.00 is requested) for payment to secure price, materials, labor, project planning, and scheduling. If not approved for financing, the deposit will be refunded.</string>
                                                        <attributes>
                                                            <color key="NSColor" red="0.1764705882" green="0.20392156859999999" blue="0.23921568630000001" alpha="1" colorSpace="calibratedRGB"/>
                                                            <font key="NSFont" size="18" name="Avenir-Medium"/>
                                                            <paragraphStyle key="NSParagraphStyle" alignment="left" lineBreakMode="wordWrapping" baseWritingDirection="natural" tighteningFactorForTruncation="0.0" allowsDefaultTighteningForTruncation="NO"/>
                                                        </attributes>
                                                    </fragment>
                                                </attributedString>
                                                <nil key="highlightedColor"/>
                                            </label>
